<cve>CVE-2025-0411</cve>
<cvss3_base_score>7.0</cvss3_base_score>
<description>The version of 7-Zip on the remote host does not carry the Mark-of-the-Web to files extracted from a crafted nested archive. A phishing attachment can then run without SmartScreen or Office Protected View warnings.</description>
<exploit_available>true</exploit_available>
<fname>214985.nasl</fname>
<plugin_name>7-Zip &lt; 24.09 Mark-of-the-Web Bypass</plugin_name>
